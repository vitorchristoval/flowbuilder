{
  "version": "7.2",
  "screens": [
    {
      "id": "PERSONAL_INFO",
      "title": "Your Information",
      "data": {},
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              { "type": "TextHeading", "text": "Book an Appointment" },
              { "type": "TextInput", "name": "full_name", "label": "Full Name", "required": true, "input-type": "text" },
              { "type": "TextInput", "name": "phone", "label": "Phone Number", "required": true, "input-type": "text" },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "APPOINTMENT_DATE" },
                  "payload": {
                    "full_name": "${form.full_name}",
                    "phone": "${form.phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "APPOINTMENT_DATE",
      "title": "Pick a Date",
      "data": {
        "full_name": { "type": "string", "__example__": "John Doe" },
        "phone": { "type": "string", "__example__": "11999999999" }
      },
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              { "type": "TextHeading", "text": "Choose Your Appointment" },
              { "type": "DatePicker", "name": "date", "label": "Preferred Date", "required": true },
              {
                "type": "RadioButtonsGroup",
                "name": "time_slot",
                "label": "Time Slot",
                "required": true,
                "data-source": [
                  { "id": "morning", "title": "Morning (9am – 12pm)" },
                  { "id": "afternoon", "title": "Afternoon (1pm – 5pm)" },
                  { "id": "evening", "title": "Evening (6pm – 8pm)" }
                ]
              },
              {
                "type": "Footer",
                "label": "Confirm",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "full_name": "${data.full_name}",
                    "phone": "${data.phone}",
                    "date": "${form.date}",
                    "time_slot": "${form.time_slot}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
