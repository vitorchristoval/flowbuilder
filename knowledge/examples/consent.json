{
  "version": "7.2",
  "screens": [
    {
      "id": "PERSONAL_INFO",
      "title": "Your Information",
      "data": {},
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              { "type": "TextHeading", "text": "Enter Your Details" },
              { "type": "TextInput", "name": "full_name", "label": "Full Name", "required": true, "input-type": "text" },
              { "type": "TextInput", "name": "phone", "label": "Phone Number", "required": true, "input-type": "text" },
              { "type": "TextInput", "name": "email", "label": "Email Address", "required": true, "input-type": "email" },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "CONSENT" },
                  "payload": {
                    "full_name": "${form.full_name}",
                    "phone": "${form.phone}",
                    "email": "${form.email}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONSENT",
      "title": "Data Consent",
      "data": {
        "full_name": { "type": "string", "__example__": "John Doe" },
        "phone": { "type": "string", "__example__": "11999999999" },
        "email": { "type": "string", "__example__": "john@example.com" }
      },
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              { "type": "TextHeading", "text": "Consent to Data Usage" },
              { "type": "TextBody", "text": "We need your consent to process your data." },
              {
                "type": "CheckboxGroup",
                "name": "consent",
                "label": "Do you agree to the terms?",
                "required": true,
                "data-source": [
                  { "id": "agree", "title": "I agree to the terms and conditions" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "CONFIRMATION" },
                  "payload": {
                    "full_name": "${data.full_name}",
                    "phone": "${data.phone}",
                    "email": "${data.email}",
                    "consent": "${form.consent}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRMATION",
      "title": "Confirmed",
      "data": {
        "full_name": { "type": "string", "__example__": "John Doe" },
        "phone": { "type": "string", "__example__": "11999999999" },
        "email": { "type": "string", "__example__": "john@example.com" },
        "consent": { "type": "array", "items": { "type": "string" }, "__example__": ["agree"] }
      },
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              { "type": "TextHeading", "text": "All Done!" },
              { "type": "TextBody", "text": "Your consent has been recorded." },
              {
                "type": "Footer",
                "label": "Finish",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "full_name": "${data.full_name}",
                    "phone": "${data.phone}",
                    "email": "${data.email}",
                    "consent": "${data.consent}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
